{
  "name": "meeting-assistant",
  "version": "1.0.0",
  "description": "AI meeting assistant overlay",
  "main": "./out/main/index.js",
  "author": "Aformely",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test:backend": "node test/test-backend.mjs",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.4"
  },
  "dependencies": {
    "electron-audio-loopback": "^1.0.6",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "io.aformely.meetingassistant",
    "productName": "Meeting Assistant",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "asarUnpack": ["**/node_modules/electron-audio-loopback/**"],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Transcribes your side of the meeting.",
        "NSScreenCaptureUsageDescription": "Captures system audio to transcribe other participants."
      }
    },
    "dmg": {
      "title": "Meeting Assistant"
    }
  }
}
